generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  authId    String   @unique
  email     String
  name      String?
  role      String
  createdAt DateTime @default(now())

  bodyMeasurements BodyMeasurement[]
  workoutTypes     WorkoutType[]
  workoutSessions WorkoutSession[]
  @@map("users")
}

model BodyMeasurement {
  id         Int      @id @default(autoincrement())
  chest      Int?
  waist      Int?
  hips       Int?
  leftArm    Int?
  rightArm   Int?
  leftThigh  Int?
  rightThigh Int?
  leftCalf   Int?
  rightCalf  Int?
  createdAt  DateTime @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  @@map("body_measurements")
}

model WorkoutType {
  id          String   @id @default(uuid())
  name        String
  description String
  status      Boolean
  createdAt   DateTime @default(now())
  userId String       @db.Uuid

  plans  WorkoutPlan[]
  user   User?        @relation(fields: [userId], references: [id])
  
  @@map("workout_types")
}

model WorkoutPlan {
  id        String   @id @default(uuid())
  name      String
  status    Boolean
  createdAt DateTime @default(now())

  workoutTypeId String
  workoutType   WorkoutType @relation(fields: [workoutTypeId], references: [id], onDelete: Cascade)

  plansExercises  WorkoutPlanExercise[]
  workoutSessions WorkoutSession[]
  @@map("workout_plans")
}


model WorkoutPlanExercise {
  id              String   @id @default(uuid())
  workoutPlanId   String
  exerciseId      String

  workoutPlan    WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercise       Exercise @relation(fields: [exerciseId], references: [id]) 
  
  exerciseSet  ExerciseSet[]
  performedSets PerformedSet[]
  @@map("workout_plans_exercises")
}

model ExerciseType {
  id   String @id @default(uuid())
  name String

  exercises Exercise[]

  @@map("exercise_types")
}

model Exercise {
  id        String   @id @default(uuid())
  name      String
  status    Boolean
  createdAt DateTime @default(now())
  
  exerciseTypeId       String
  exerciseType         ExerciseType          @relation(fields: [exerciseTypeId], references: [id])
  plansExercises  WorkoutPlanExercise[]

  @@map("exercises")
}

model ExerciseSet {
  id                        String @id @default(uuid())
  workoutPlanExerciseId     String
  sets                      Int
  weight                    Float
  reps                      Int
  rest                      Int
  muscle                    String
  order                     Int

  createdAt DateTime @default(now())

  workoutPlanExercise    WorkoutPlanExercise @relation(fields: [workoutPlanExerciseId], references: [id], onDelete: Cascade)
  @@map("exercise_sets")
}

model WorkoutSession {
  id            String         @id @default(uuid())
  userId        String         @db.Uuid
  workoutPlanId String
  startTime     DateTime       @default(now())
  endTime       DateTime?
  totalTime     Int? 
  status        SessionStatus  @default(IN_PROGRESS)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutPlan   WorkoutPlan    @relation(fields: [workoutPlanId], references: [id])

  performedSets PerformedSet[]
  restPeriods   RestPeriod[]

  @@map("workout_sessions")
}

model PerformedSet {
  id                 String   @id @default(uuid())
  workoutSessionId   String
  workoutPlanExerciseId String
  setNumber          Int  
  repsCompleted      Int
  weightUsed         Float
  restTime           Int?   
  notes              String?
  completedAt        DateTime @default(now())
  createdAt          DateTime @default(now())

  workoutSession     WorkoutSession     @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  workoutPlanExercise WorkoutPlanExercise @relation(fields: [workoutPlanExerciseId], references: [id])

  @@map("performed_sets")
}

model RestPeriod {
  id               String   @id @default(uuid())
  workoutSessionId String
  startTime        DateTime
  endTime          DateTime?
  duration         Int? 
  createdAt        DateTime @default(now())

  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@map("rest_periods")
}

enum SessionStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED
}